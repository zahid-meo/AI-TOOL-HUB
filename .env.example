# ---- Copy this file to ".env" and fill in your values ----
APP_ENV=production
APP_NAME="AI Tools Hub"
# Leave empty to auto-detect. Example: https://yourdomain.com
APP_URL=
# Leave empty to auto-detect sub-folder installs. Example: /ai_tool_hub
APP_BASE_PATH=
# true  => /tools/word-counter   (needs Apache mod_rewrite + .htaccess)
# false => /tools/word-counter.php
CLEAN_URLS=true

# ---- MySQL / MariaDB ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_tool_hub
DB_USER=root
DB_PASS=

# ---- Contact ----
CONTACT_EMAIL=zahidchoudhary797@gmail.com
CONTACT_WHATSAPP=923042211410
# true => also send an email notification when someone uses the contact form
MAIL_NOTIFY=false

# ---- Google AdSense (leave empty to show neutral placeholders) ----
ADSENSE_CLIENT=
ADSENSE_SLOT_HEADER=
ADSENSE_SLOT_INLINE=
ADSENSE_SLOT_FOOTER=
SHOW_AD_PLACEHOLDERS=true

# ---- Optional: Google Analytics 4 measurement id (G-XXXXXXXXXX) ----
GA_MEASUREMENT_ID=

# Random string used to hash visitor IPs (change it!)
APP_SECRET=change-this-to-a-long-random-string
